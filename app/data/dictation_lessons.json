[
  {
    "id": "greetings",
    "title_zh": "打招呼",
    "title_ja": "あいさつ",
    "items": [
      {"id": "g-01", "ja": "おはようございます。", "reading": "おはようございます。", "zh": "早上好。"},
      {"id": "g-02", "ja": "こんにちは。", "reading": "こんにちは。", "zh": "你好。"},
      {"id": "g-03", "ja": "元気ですか。", "reading": "げんきですか。", "zh": "你好吗？"},
      {"id": "g-04", "ja": "はい、元気です。", "reading": "はい、げんきです。", "zh": "是的，我很好。"},
      {"id": "g-05", "ja": "今日は暑いですね。", "reading": "きょうはあついですね。", "zh": "今天真热啊。"},
      {"id": "g-06", "ja": "そうですね。", "reading": "そうですね。", "zh": "是啊。"},
      {"id": "g-07", "ja": "じゃあ、また。", "reading": "じゃあ、また。", "zh": "那回头见。"},
      {"id": "g-08", "ja": "さようなら。", "reading": "さようなら。", "zh": "再见。"}
    ]
  },
  {
    "id": "cafe-short",
    "title_zh": "咖啡店短句",
    "title_ja": "カフェの短い文",
    "items": [
      {"id": "c-01", "ja": "コーヒーをください。", "reading": "コーヒーをください。", "zh": "请给我咖啡。"},
      {"id": "c-02", "ja": "砂糖はいいです。", "reading": "さとうはいいです。", "zh": "不用糖。"},
      {"id": "c-03", "ja": "ここで飲みます。", "reading": "ここでのみます。", "zh": "我在这里喝。"},
      {"id": "c-04", "ja": "いくらですか。", "reading": "いくらですか。", "zh": "多少钱？"},
      {"id": "c-05", "ja": "三百円です。", "reading": "さんびゃくえんです。", "zh": "300日元。"},
      {"id": "c-06", "ja": "カードで払います。", "reading": "カードではらいます。", "zh": "用卡付。"},
      {"id": "c-07", "ja": "ありがとうございます。", "reading": "ありがとうございます。", "zh": "谢谢。"},
      {"id": "c-08", "ja": "美味しかったです。", "reading": "おいしかったです。", "zh": "很好喝。"}
    ]
  },
  {
    "id": "station-short",
    "title_zh": "车站短句",
    "title_ja": "駅の短い文",
    "items": [
      {"id": "s-01", "ja": "駅はどこですか。", "reading": "えきはどこですか。", "zh": "车站在哪里？"},
      {"id": "s-02", "ja": "切符を買います。", "reading": "きっぷをかいます。", "zh": "我买票。"},
      {"id": "s-03", "ja": "東京までお願いします。", "reading": "とうきょうまでおねがいします。", "zh": "到东京。"},
      {"id": "s-04", "ja": "何番線ですか。", "reading": "なんばんせんですか。", "zh": "是几号线？"},
      {"id": "s-05", "ja": "次の電車です。", "reading": "つぎのでんしゃです。", "zh": "是下一班电车。"},
      {"id": "s-06", "ja": "降ります。", "reading": "おります。", "zh": "我要下车。"},
      {"id": "s-07", "ja": "乗り換えます。", "reading": "のりかえます。", "zh": "我要换乘。"},
      {"id": "s-08", "ja": "着きました。", "reading": "つきました。", "zh": "到了。"}
    ]
  },
  {
    "id": "shop-short",
    "title_zh": "购物短句",
    "title_ja": "買い物の短い文",
    "items": [
      {"id": "p-01", "ja": "これをください。", "reading": "これをください。", "zh": "请给我这个。"},
      {"id": "p-02", "ja": "いくらですか。", "reading": "いくらですか。", "zh": "多少钱？"},
      {"id": "p-03", "ja": "高いです。", "reading": "たかいです。", "zh": "好贵。"},
      {"id": "p-04", "ja": "安いです。", "reading": "やすいです。", "zh": "便宜。"},
      {"id": "p-05", "ja": "試着します。", "reading": "しちゃくします。", "zh": "我试穿。"},
      {"id": "p-06", "ja": "これにします。", "reading": "これにします。", "zh": "就要这个。"},
      {"id": "p-07", "ja": "袋をお願いします。", "reading": "ふくろをおねがいします。", "zh": "请给我袋子。"},
      {"id": "p-08", "ja": "レシートをください。", "reading": "レシートをください。", "zh": "请给我小票。"}
    ]
  },
  {
    "id": "daily",
    "title_zh": "日常生活",
    "title_ja": "毎日の言葉",
    "items": [
      {"id": "d-01", "ja": "今、何時ですか。", "reading": "いま、なんじですか。", "zh": "现在几点？"},
      {"id": "d-02", "ja": "三時です。", "reading": "さんじです。", "zh": "三点。"},
      {"id": "d-03", "ja": "少し待ってください。", "reading": "すこしまってください。", "zh": "请稍等。"},
      {"id": "d-04", "ja": "わかりました。", "reading": "わかりました。", "zh": "明白了。"},
      {"id": "d-05", "ja": "もう一度お願いします。", "reading": "もういちどおねがいします。", "zh": "请再说一次。"},
      {"id": "d-06", "ja": "ゆっくり話してください。", "reading": "ゆっくりはなしてください。", "zh": "请说慢一点。"},
      {"id": "d-07", "ja": "大丈夫です。", "reading": "だいじょうぶです。", "zh": "没关系。"},
      {"id": "d-08", "ja": "ありがとうございます。", "reading": "ありがとうございます。", "zh": "谢谢。"}
    ]
  },
  {
    "id": "travel",
    "title_zh": "旅行问路",
    "title_ja": "旅行の言葉",
    "items": [
      {"id": "t-01", "ja": "トイレはどこですか。", "reading": "トイレはどこですか。", "zh": "厕所在哪里？"},
      {"id": "t-02", "ja": "まっすぐ行ってください。", "reading": "まっすぐいってください。", "zh": "请直走。"},
      {"id": "t-03", "ja": "右に曲がります。", "reading": "みぎにまがります。", "zh": "向右转。"},
      {"id": "t-04", "ja": "左です。", "reading": "ひだりです。", "zh": "在左边。"},
      {"id": "t-05", "ja": "近いですか。", "reading": "ちかいですか。", "zh": "近吗？"},
      {"id": "t-06", "ja": "歩いて五分です。", "reading": "あるいてごふんです。", "zh": "走路五分钟。"},
      {"id": "t-07", "ja": "地図をください。", "reading": "ちずをください。", "zh": "请给我地图。"},
      {"id": "t-08", "ja": "助かりました。", "reading": "たすかりました。", "zh": "帮大忙了。"}
    ]
  }
]
