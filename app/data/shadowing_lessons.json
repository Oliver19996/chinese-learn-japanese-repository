[
  {
    "id": "cafe",
    "title_zh": "咖啡店点单",
    "title_ja": "カフェで注文",
    "items": [
      {"id": "cafe-01", "ja": "すみません。", "reading": "すみません。", "zh": "不好意思。"},
      {"id": "cafe-02", "ja": "メニューを見せてください。", "reading": "メニューをみせてください。", "zh": "请给我看菜单。"},
      {"id": "cafe-03", "ja": "ホットコーヒーを一つお願いします。", "reading": "ホットコーヒーをひとつおねがいします。", "zh": "请给我一杯热咖啡。"},
      {"id": "cafe-04", "ja": "砂糖は入れますか。", "reading": "さとうはいれますか。", "zh": "要放糖吗？"},
      {"id": "cafe-05", "ja": "いいえ、そのままお願いします。", "reading": "いいえ、そのままおねがいします。", "zh": "不用，原味就好。"},
      {"id": "cafe-06", "ja": "こちらでお飲みですか。", "reading": "こちらでののみですか。", "zh": "在店里喝吗？"},
      {"id": "cafe-07", "ja": "はい、ここで飲みます。", "reading": "はい、ここでのみます。", "zh": "是的，我在这里喝。"},
      {"id": "cafe-08", "ja": "ありがとうございました。", "reading": "ありがとうございました。", "zh": "谢谢您。"}
    ]
  },
  {
    "id": "station",
    "title_zh": "车站买票",
    "title_ja": "駅で切符を買う",
    "items": [
      {"id": "station-01", "ja": "すみません、渋谷までお願いします。", "reading": "すみません、しぶやまでおねがいします。", "zh": "不好意思，到涩谷。"},
      {"id": "station-02", "ja": "切符はどこで買いますか。", "reading": "きっぷはどこでかいますか。", "zh": "车票在哪里买？"},
      {"id": "station-03", "ja": "この機械で買えます。", "reading": "このきかいでかえます。", "zh": "可以用这台机器买。"},
      {"id": "station-04", "ja": "いくらですか。", "reading": "いくらですか。", "zh": "多少钱？"},
      {"id": "station-05", "ja": "百六十円です。", "reading": "ひゃくろくじゅうえんです。", "zh": "160日元。"},
      {"id": "station-06", "ja": "何番線ですか。", "reading": "なんばんせんですか。", "zh": "是几号线？"},
      {"id": "station-07", "ja": "三番線です。", "reading": "さんばんせんです。", "zh": "是3号线。"},
      {"id": "station-08", "ja": "ありがとうございます。", "reading": "ありがとうございます。", "zh": "谢谢。"}
    ]
  },
  {
    "id": "convenience",
    "title_zh": "便利店结账",
    "title_ja": "コンビニで会計",
    "items": [
      {"id": "convenience-01", "ja": "これをください。", "reading": "これをください。", "zh": "请给我这个。"},
      {"id": "convenience-02", "ja": "温めますか。", "reading": "あたためますか。", "zh": "要加热吗？"},
      {"id": "convenience-03", "ja": "はい、お願いします。", "reading": "はい、おねがいします。", "zh": "好的，拜托了。"},
      {"id": "convenience-04", "ja": "袋はいりますか。", "reading": "ふくろはいりますか。", "zh": "需要袋子吗？"},
      {"id": "convenience-05", "ja": "いいえ、大丈夫です。", "reading": "いいえ、だいじょうぶです。", "zh": "不用，没关系。"},
      {"id": "convenience-06", "ja": "ポイントカードはありますか。", "reading": "ポイントカードはありますか。", "zh": "有积分卡吗？"},
      {"id": "convenience-07", "ja": "現金で払います。", "reading": "げんきんではらいます。", "zh": "用现金付。"},
      {"id": "convenience-08", "ja": "レシートをどうぞ。", "reading": "レシートをどうぞ。", "zh": "请拿好小票。"}
    ]
  },
  {
    "id": "restaurant",
    "title_zh": "餐厅点菜",
    "title_ja": "レストランで注文",
    "items": [
      {"id": "restaurant-01", "ja": "二人です。", "reading": "ふたりです。", "zh": "两位。"},
      {"id": "restaurant-02", "ja": "メニューをお願いします。", "reading": "メニューをおねがいします。", "zh": "请给我菜单。"},
      {"id": "restaurant-03", "ja": "おすすめは何ですか。", "reading": "おすすめはなんですか。", "zh": "有什么推荐？"},
      {"id": "restaurant-04", "ja": "ラーメンが人気です。", "reading": "ラーメンがにんきです。", "zh": "拉面很受欢迎。"},
      {"id": "restaurant-05", "ja": "辛くないですか。", "reading": "からくないですか。", "zh": "辣吗？"},
      {"id": "restaurant-06", "ja": "少し辛いです。", "reading": "すこしからいです。", "zh": "有一点辣。"},
      {"id": "restaurant-07", "ja": "水をください。", "reading": "みずをください。", "zh": "请给我水。"},
      {"id": "restaurant-08", "ja": "会計をお願いします。", "reading": "かいけいをおねがいします。", "zh": "请结账。"},
      {"id": "restaurant-09", "ja": "ごちそうさまでした。", "reading": "ごちそうさまでした。", "zh": "多谢款待。"}
    ]
  },
  {
    "id": "greeting",
    "title_zh": "初次见面",
    "title_ja": "はじめまして",
    "items": [
      {"id": "greeting-01", "ja": "はじめまして。", "reading": "はじめまして。", "zh": "初次见面。"},
      {"id": "greeting-02", "ja": "李です。中国から来ました。", "reading": "りです。ちゅうごくからきました。", "zh": "我姓李，从中国来。"},
      {"id": "greeting-03", "ja": "どうぞよろしくお願いします。", "reading": "どうぞよろしくおねがいします。", "zh": "请多关照。"},
      {"id": "greeting-04", "ja": "お仕事は何ですか。", "reading": "おしごとはなんですか。", "zh": "您做什么工作？"},
      {"id": "greeting-05", "ja": "学生です。日本語を勉強しています。", "reading": "がくせいです。にほんごをべんきょうしています。", "zh": "我是学生，正在学日语。"},
      {"id": "greeting-06", "ja": "日本語が上手ですね。", "reading": "にほんごがじょうずですね。", "zh": "你日语真好。"},
      {"id": "greeting-07", "ja": "いいえ、まだまだです。", "reading": "いいえ、まだまだです。", "zh": "哪里，还差得远。"},
      {"id": "greeting-08", "ja": "また会いましょう。", "reading": "またあいましょう。", "zh": "下次再见。"}
    ]
  },
  {
    "id": "shopping",
    "title_zh": "购物试穿",
    "title_ja": "店で試着",
    "items": [
      {"id": "shopping-01", "ja": "これを見てもいいですか。", "reading": "これをみてもいいですか。", "zh": "可以看看这个吗？"},
      {"id": "shopping-02", "ja": "はい、どうぞ。", "reading": "はい、どうぞ。", "zh": "好的，请。"},
      {"id": "shopping-03", "ja": "試着してもいいですか。", "reading": "しちゃくしてもいいですか。", "zh": "可以试穿吗？"},
      {"id": "shopping-04", "ja": "試着室はあちらです。", "reading": "しちゃくしつはあちらです。", "zh": "试衣间在那边。"},
      {"id": "shopping-05", "ja": "もう少し大きいサイズはありますか。", "reading": "もうすこしおおきいサイズはありますか。", "zh": "有再大一点的尺码吗？"},
      {"id": "shopping-06", "ja": "これはいくらですか。", "reading": "これはいくらですか。", "zh": "这个多少钱？"},
      {"id": "shopping-07", "ja": "少し高いです。", "reading": "すこしたかいです。", "zh": "有点贵。"},
      {"id": "shopping-08", "ja": "これにします。", "reading": "これにします。", "zh": "就要这个。"}
    ]
  },
  {
    "id": "directions",
    "title_zh": "问路",
    "title_ja": "道を聞く",
    "items": [
      {"id": "directions-01", "ja": "すみません、駅はどこですか。", "reading": "すみません、えきはどこですか。", "zh": "不好意思，车站在哪里？"},
      {"id": "directions-02", "ja": "この道をまっすぐ行ってください。", "reading": "このみちをまっすぐいってください。", "zh": "请沿这条路直走。"},
      {"id": "directions-03", "ja": "二つ目の信号を右に曲がります。", "reading": "ふたつめのしんごうをみぎにまがります。", "zh": "在第二个红绿灯右转。"},
      {"id": "directions-04", "ja": "遠いですか。", "reading": "とおいですか。", "zh": "远吗？"},
      {"id": "directions-05", "ja": "歩いて十分です。", "reading": "あるいてじゅっぷんです。", "zh": "走路十分钟。"},
      {"id": "directions-06", "ja": "地図を見せてもいいですか。", "reading": "ちずをみせてもいいですか。", "zh": "可以给我看地图吗？"},
      {"id": "directions-07", "ja": "わかりました。ありがとうございます。", "reading": "わかりました。ありがとうございます。", "zh": "明白了，谢谢。"}
    ]
  },
  {
    "id": "hospital",
    "title_zh": "预约医院",
    "title_ja": "病院の予約",
    "items": [
      {"id": "hospital-01", "ja": "予約をお願いします。", "reading": "よやくをおねがいします。", "zh": "我想预约。"},
      {"id": "hospital-02", "ja": "お名前をどうぞ。", "reading": "おなまえをどうぞ。", "zh": "请告诉我您的姓名。"},
      {"id": "hospital-03", "ja": "熱があります。", "reading": "ねつがあります。", "zh": "我发烧了。"},
      {"id": "hospital-04", "ja": "いつからですか。", "reading": "いつからですか。", "zh": "从什么时候开始的？"},
      {"id": "hospital-05", "ja": "昨日からです。", "reading": "きのうからです。", "zh": "从昨天开始。"},
      {"id": "hospital-06", "ja": "午後三時は空いていますか。", "reading": "ごごさんじはあいていますか。", "zh": "下午三点有空吗？"},
      {"id": "hospital-07", "ja": "保険証を見せてください。", "reading": "ほけんしょうをみせてください。", "zh": "请出示保险证。"},
      {"id": "hospital-08", "ja": "お大事に。", "reading": "おだいじに。", "zh": "请多保重。"}
    ]
  }
]
